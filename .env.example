# Copy to .env and fill in locally (never commit .env)
# API_TYPE=openai_http
# API_TYPE=anthropic_http
# API_TYPE=gemini

# --- OpenAI-compatible (Omniroute, Ollama /v1, LiteLLM, OpenAI, …) ---
OPENAI_MODEL=ollama/gpt-oss:120b-cloud
OPENAI_URL_ENDPOINT=http://127.0.0.1:20128/v1/chat/completions
# True = send Authorization: Bearer <OPENAI_URL_API>
OPENAI_URL_API=

# --- Anthropic Messages API (native or compatible proxy) ---
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_URL_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_API=True
ANTHROPIC_URL_API=

# --- Gemini ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API=
